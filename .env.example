# Public site URL (no trailing slash). Used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://freetools-hub.pages.dev

# Contact email shown on the Contact page (mailto link). Required for a working contact method.
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional: URL of the FastAPI backend (enables the on-site contact form). Leave empty to use email only.
NEXT_PUBLIC_API_URL=

# Google Analytics 4 measurement ID (e.g. G-XXXXXXX). Empty = analytics disabled.
NEXT_PUBLIC_GA_ID=

# Google AdSense. Disabled unless ENABLED=true AND a client ID is set.
NEXT_PUBLIC_ADSENSE_ENABLED=false
NEXT_PUBLIC_ADSENSE_CLIENT=
# Manual ad unit slot IDs (optional; leave empty if using Auto Ads only)
NEXT_PUBLIC_ADSENSE_SLOT_HOME=
NEXT_PUBLIC_ADSENSE_SLOT_TOOL=
NEXT_PUBLIC_ADSENSE_SLOT_CONTENT=

# Google Search Console HTML-tag verification token (content value only). Optional.
NEXT_PUBLIC_GSC_VERIFICATION=
